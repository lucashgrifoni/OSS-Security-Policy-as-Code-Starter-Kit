{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucashgrifoni/OSS-Security-Policy-as-Code-Starter-Kit/reports/schema/evidence-github-secret-scanning.schema.json",
  "title": "GitHub secret scanning evidence",
  "type": "object",
  "required": ["schema_version", "attested_at", "attested_by", "repository", "posture"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "github-secret-scanning/v1" },
    "attested_at": { "type": "string", "format": "date" },
    "attested_by": { "type": "string" },
    "repository": { "type": "string" },
    "posture": {
      "type": "object",
      "required": ["secret_scanning_enabled", "push_protection_enabled", "validity_checks_enabled"],
      "additionalProperties": false,
      "properties": {
        "secret_scanning_enabled": { "type": "boolean" },
        "push_protection_enabled": { "type": "boolean" },
        "validity_checks_enabled": { "type": "boolean" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_collection_method", "collected_at", "source_url"],
      "properties": {
        "evidence_collection_method": { "type": "string", "enum": ["live", "manual"] },
        "collected_at": { "type": "string" },
        "source_url": { "type": "string" },
        "mode": { "type": "string", "enum": ["api"] }
      }
    },
    "notes": { "type": "string" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucashgrifoni/OSS-Security-Policy-as-Code-Starter-Kit/reports/schema/evidence-github-provenance-artifact.schema.json",
  "title": "GitHub provenance / Artifact Attestation bound to a release artifact",
  "description": "Per-artifact provenance evidence consumed by PROV-VERIFY-061. Place at .oss-policy-kit/evidence/github-provenance-artifact.json. The verification block records that the bundle was independently verified (e.g. `gh attestation verify`).",
  "type": "object",
  "required": ["schema_version", "attested_at", "attested_by", "artifact", "attestation", "posture"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "github-provenance-artifact/v1" },
    "attested_at": { "type": "string", "format": "date" },
    "attested_by": { "type": "string" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest_sha256"],
      "properties": {
        "uri": { "type": "string" },
        "digest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest_sha256"],
      "properties": {
        "kind": { "type": "string", "enum": ["sigstore-bundle", "github-artifact-attestation", "cosign", "in-toto", "other"] },
        "digest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation_covers_release_artifact", "attestation_digest_recorded", "artifact_digest_recorded"],
      "properties": {
        "attestation_covers_release_artifact": { "type": "boolean" },
        "attestation_digest_recorded": { "type": "boolean" },
        "artifact_digest_recorded": { "type": "boolean" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_collection_method", "collected_at", "source_url"],
      "properties": {
        "evidence_collection_method": { "type": "string", "enum": ["live", "manual"] },
        "collected_at": { "type": "string" },
        "source_url": { "type": "string" },
        "mode": { "type": "string", "enum": ["api"] }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "verified_at", "transparency_log_inclusion"],
      "description": "Optional. Records that the attestation bundle was independently verified. Consumed by PROV-VERIFY-061.",
      "properties": {
        "method": { "type": "string", "enum": ["gh-attestation-verify", "cosign-verify-bundle", "cosign-verify-attestation", "in-toto-verify", "other"] },
        "verified_at": { "type": "string", "format": "date-time" },
        "transparency_log_inclusion": { "type": "boolean" },
        "issuer": { "type": "string" },
        "subject_alternative_name": { "type": "string" },
        "bundle_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tool_version": { "type": "string" },
        "source": { "type": "string", "enum": ["npm-trusted-publishing", "pypi-trusted-publishing", "rubygems-trusted-publishing", "crates-trusted-publishing", "github-attestation", "sigstore-bundle", "rekor-v2-tile-inclusion", "manual"], "description": "Where the verification originates. Optional; default behaviour is unchanged when omitted. Added in v6.0.0 (V6-10) so adopters can distinguish Trusted-Publishing-anchored verifications from a manual cosign run. 'rekor-v2-tile-inclusion' added in Cycle 2 (PR-24) for Sigstore Rekor v2 tile-based inclusion proofs." }
      }
    },
    "notes": { "type": "string" }
  }
}

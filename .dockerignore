# Keep the build context small. The Dockerfile installs from the checked-out
# source tree so container publication does not race PyPI availability.
.git/
.github/
.gitignore
.venv/
.pytest_cache/
.tmp-validation/
.tmp/
.ruff_cache/
.mypy_cache/
__pycache__/
*.pyc
*.pyo
dist/
build/
*.egg-info/
melhorias/
out/
tests/
docs/
examples/
gitpage/
pipelines/
reports/
waivers/
scripts/
CHANGELOG.md
SECURITY.md

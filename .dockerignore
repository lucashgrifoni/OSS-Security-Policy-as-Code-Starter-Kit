# Keep the build context small. The Dockerfile installs from PyPI so
# we do not need the source tree inside the build context — only the
# Dockerfile itself.
.git/
.github/
.gitignore
.venv/
.pytest_cache/
.tmp-validation/
.tmp/
.ruff_cache/
.mypy_cache/
__pycache__/
*.pyc
*.pyo
dist/
build/
*.egg-info/
melhorias/
out/
tests/
docs/
examples/
gitpage/
pipelines/
reports/
waivers/
scripts/
src/
CHANGELOG.md
README.md
SECURITY.md
NOTICE
LICENSE
pyproject.toml

# Local assistant/workspace state
.claude/
.agents/
.codex/
# OpenWiki init scaffolds this locally; CI adoption is a separate change.
/.github/workflows/openwiki-update.yml
.cursorrules
# Agent instruction files are local operating context, never public surface.
# CLAUDE.md was tracked by accident and is ignored here so it cannot return.
CLAUDE.md
AGENTS.md
GEMINI.md
.aider*
.github/copilot-instructions.md
.vscode/
/melhorias/

# Ignore local kit output everywhere; do not remove this broad rule.
.oss-policy-kit/
# Exception: version synthetic evidence for the bundled hardened-repo fixture only.
!examples/hardened-repo/.oss-policy-kit/
!examples/hardened-repo/.oss-policy-kit/evidence/
!examples/hardened-repo/.oss-policy-kit/evidence/**
!examples/ai-agent-baseline-repo/.oss-policy-kit/
!examples/ai-agent-baseline-repo/.oss-policy-kit/evidence/
!examples/ai-agent-baseline-repo/.oss-policy-kit/evidence/**

# Python caches, virtualenvs, and build outputs
.coverage
# The parallel data files, which `.coverage` alone does not cover. Every run of the
# two-step gate leaves a batch of `.coverage.<hostname>.<pid>.<random>` behind -- 183 of
# them were sitting untracked in this working tree, each carrying the machine name in its
# filename. They showed up in `git status`, so one `git add -A` would have committed the
# hostname 183 times, and the public hygiene scanner walked all of them on every run
# because it lists untracked-but-not-ignored files.
.coverage.*
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
.venv-*/
venv/
*-venv/
__pycache__/
*.egg-info/
*.py[cod]
build/
coverage.xml
dist/
htmlcov/

# Generated reports and temporary evaluation labs
.scannerwork/
artifacts/
out/
sonar-report/
# Local Sonar working area: findings, status, reports, PDFs — never push to remote.
sonar/
sonar-project.properties
# Local scratch output from `export-evidence` / SARIF export runs.
evidence-export.json
test-runs/
.tmp/
.tmp-validation/
reports/validacao-*/
# Local-only analysis/review scratch reports (never push to remote).
_analysis_outputs/

# Front-end local dependencies/build outputs
gitpage/dist/
gitpage/node_modules/

# Local secrets and private notes
.env
.env.*
.secrets/
secrets/
private-notes/
ROADMAP.md
docs/releasing.md

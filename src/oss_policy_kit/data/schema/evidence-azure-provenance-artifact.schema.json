{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucashgrifoni/OSS-Security-Policy-as-Code-Starter-Kit/reports/schema/evidence-azure-provenance-artifact.schema.json",
  "title": "Azure DevOps provenance / attestation bound to a release artifact",
  "type": "object",
  "required": ["schema_version", "attested_at", "attested_by", "artifact", "attestation", "posture"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "azure-provenance-artifact/v1" },
    "attested_at": { "type": "string", "format": "date" },
    "attested_by": { "type": "string" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest_sha256"],
      "properties": {
        "uri": { "type": "string" },
        "digest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest_sha256"],
      "properties": {
        "kind": { "type": "string", "enum": ["cosign", "sigstore", "in-toto", "other"] },
        "digest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation_covers_release_artifact", "attestation_digest_recorded", "artifact_digest_recorded"],
      "properties": {
        "attestation_covers_release_artifact": { "type": "boolean" },
        "attestation_digest_recorded": { "type": "boolean" },
        "artifact_digest_recorded": { "type": "boolean" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_collection_method", "collected_at", "source_url"],
      "properties": {
        "evidence_collection_method": { "type": "string", "enum": ["live", "manual"] },
        "collected_at": { "type": "string" },
        "source_url": { "type": "string" },
        "mode": { "type": "string", "enum": ["api"] }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "verified_at", "transparency_log_inclusion"],
      "description": "Optional. Records that the attestation bundle was independently verified (e.g. cosign verify-bundle, gh attestation verify). Consumed by PROV-VERIFY-061.",
      "properties": {
        "method": { "type": "string", "enum": ["gh-attestation-verify", "cosign-verify-bundle", "cosign-verify-attestation", "in-toto-verify", "other"] },
        "verified_at": { "type": "string", "format": "date-time" },
        "transparency_log_inclusion": { "type": "boolean" },
        "issuer": { "type": "string" },
        "subject_alternative_name": { "type": "string" },
        "bundle_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tool_version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucashgrifoni/OSS-Security-Policy-as-Code-Starter-Kit/reports/schema/evidence-github-environment-protection.schema.json",
  "title": "GitHub environment protection evidence",
  "type": "object",
  "required": ["schema_version", "attested_at", "attested_by", "environments"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "github-environment-protection/v1" },
    "attested_at": { "type": "string", "format": "date" },
    "attested_by": { "type": "string" },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "requires_reviewers", "prevent_self_review", "wait_timer_minutes"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "requires_reviewers": { "type": "boolean" },
          "prevent_self_review": { "type": "boolean" },
          "wait_timer_minutes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_collection_method", "collected_at", "source_url"],
      "properties": {
        "evidence_collection_method": { "type": "string", "enum": ["live", "manual"] },
        "collected_at": { "type": "string" },
        "source_url": { "type": "string" },
        "mode": { "type": "string", "enum": ["api"] }
      }
    },
    "notes": { "type": "string" }
  }
}
